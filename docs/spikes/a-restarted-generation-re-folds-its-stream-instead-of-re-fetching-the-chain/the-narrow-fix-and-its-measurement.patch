index 00000000..3e42d41c
--- /dev/null
+++ b/packages/cli/test/aRestartReFoldsTheStoredStream.test.ts
@@ -0,0 +1,238 @@
+import {createClient} from '@libsql/client';
+import {declareEntities} from '@etherfold/state-store';
+import {VersionedStateStore} from '@etherfold/state-store-sqlite';
+import {mkdtemp, rm, writeFile} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import type {RemoteSQL} from 'remote-sql';
+import {RemoteLibSQL} from 'remote-sql-libsql';
+import {afterEach, describe, expect, it} from 'vitest';
+import {run, type RunningIndexer} from '../src/index.js';
+import type {Options} from '../src/types.js';
+import {ALICE, BOB, CONTRACT, fakeChain, START_BLOCK, transfer, ZERO} from './utils/chain.js';
+
+// ---------------------------------------------------------------------------------------------------
+// A RESTART RE-FOLDS THE STREAM IT ALREADY HAS, MEASURED ON THE WIRE
+// ---------------------------------------------------------------------------------------------------
+// ADR-0044 says a generation on a SHARED stream fetches NOTHING: it re-folds what
+// is stored. `ReceivingIndexer.add` used to decide that from the folds this process
+// happens to hold, and that list is EMPTY at `open` -- so a deployment restarted
+// with a changed processor was never a follower. It took a receiver and re-fetched
+// the whole chain from the source's `startBlock` while the stored emission stream
+// already held that history under the same digest (measured in
+// `work/notes/observations/a-restarted-run-refetches-the-whole-chain-instead-of-refolding-the-stored-stream.md`).
+//
+// The claim here is about the CHAIN READS and not about a flag, which is why the
+// seam is the whole command: a `run` stood up over a real libSQL handle, stopped,
+// and re-run over the SAME handle with an EDITED bundle -- a redeploy in every way
+// that matters -- with the fake node's `eth_getLogs` calls recorded across both
+// runs separately. A flag can be right while the behaviour is wrong; what cannot
+// be wrong is what the node was asked for.
+//
+// The container's own half -- that `follows` and `writesStream` come out of ONE
+// reading of the registry -- is asserted at that seam in
+// `packages/core/test/receivingContainer.test.ts`.
+// ---------------------------------------------------------------------------------------------------
+
+const INDEXER = 'nfts';
+const ADMIN_TOKEN = 'the-operators-own-secret';
+
+const LOGS = [
+	transfer(START_BLOCK + 10, '0xa10', ZERO, ALICE, 1n),
+	transfer(START_BLOCK + 20, '0xa20', ALICE, BOB, 1n),
+];
+const TIP = START_BLOCK + 50;
+
+/** THE BUNDLE A DEPLOYMENT SHIPS, as text: an upgrade is an EDIT to these bytes (ADR-0086). */
+function processorBundleSource(options: {credit: 'to' | 'from'}): string {
+	return `const abi = [
+	{
+		anonymous: false,
+		inputs: [
+			{indexed: true, internalType: 'address', name: 'from', type: 'address'},
+			{indexed: true, internalType: 'address', name: 'to', type: 'address'},
+			{indexed: true, internalType: 'uint256', name: 'id', type: 'uint256'},
+		],
+		name: 'Transfer',
+		type: 'event',
+	},
+];
+
+export const contractsDataPerChain = {
+	'1': [
+		{
+			abi,
+			address: '${CONTRACT}',
+			startBlock: ${START_BLOCK},
+		},
+	],
+};
+
+export function createProcessor() {
+	return {
+		entities: [{name: 'nft', id: ['tokenID'], fields: {owner: 'text'}}],
+		async onTransfer(state, event) {
+			const tokenID = event.args.id.toString().padStart(78, '0');
+			state.set('nft', {tokenID}, {owner: event.args.${options.credit}.toLowerCase()});
+		},
+	};
+}
+`;
+}
+
+const scratch: string[] = [];
+let running: RunningIndexer | undefined;
+
+afterEach(async () => {
+	await running?.stop().catch(() => undefined);
+	running = undefined;
+	for (const dir of scratch.splice(0)) {
+		await rm(dir, {recursive: true, force: true}).catch(() => undefined);
+	}
+	delete process.env.ADMIN_TOKEN;
+});
+
+/** ONE path a deployment is pointed at, whose BYTES the case below rewrites. */
+async function aProcessorBundleOnDisk(source: string): Promise<string> {
+	const dir = await mkdtemp(join(tmpdir(), 'etherfold-refold-'));
+	scratch.push(dir);
+	const path = join(dir, 'processor.bundle.js');
+	await writeFile(path, source, 'utf-8');
+	return path;
+}
+
+function oneDatabase(): RemoteSQL {
+	return new RemoteLibSQL(createClient({url: ':memory:'}));
+}
+
+function optionsFor(processor: string): Options {
+	return {
+		processor,
+		nodeUrl: 'http://localhost:0',
+		store: 'sqlite',
+		db: ':memory:',
+		port: '0',
+		indexer: INDEXER,
+	};
+}
+
+/**
+ * START a deployment over a database that may already hold generations, and hand
+ * back the NODE it was given so what it asked for can be read.
+ *
+ * The handle is the CALLER's, so stopping one and starting the next over the same
+ * `db` is a restart: the registry rows, the stored stream and every generation's
+ * state namespace are where the previous process left them, and the new process
+ * remembers nothing. The chain is a FRESH recorder per run, because the claim is
+ * about what THIS run asked for.
+ */
+async function aRunOver(db: RemoteSQL, processorPath: string) {
+	process.env.ADMIN_TOKEN = ADMIN_TOKEN;
+	const chain = fakeChain().serve(LOGS, TIP);
+	const started = await run(optionsFor(processorPath), {
+		provider: chain.provider,
+		createDB: () => db,
+		sleep: async () => {
+			await new Promise((resolve) => setTimeout(resolve, 1));
+		},
+		handleSignals: false,
+		log: () => {},
+		env: {MAX_BLOCKS_PER_FETCH: '20'},
+	});
+	running = started;
+	return {indexer: started, chain};
+}
+
+async function stop(): Promise<void> {
+	await running?.stop().catch(() => undefined);
+	running = undefined;
+}
+
+type SlotListing = {generations: {digest: string; canonical: boolean; stream: string; processor: string}[]};
+
+async function listingOf(indexer: RunningIndexer): Promise<SlotListing> {
+	const res = await fetch(`${indexer.url}/${INDEXER}/admin/canonical-generation`, {
+		headers: {Authorization: `Bearer ${ADMIN_TOKEN}`},
+	});
+	expect(res.status).toBe(200);
+	return (await res.json()) as SlotListing;
+}
+
+/** HOW FAR ONE GENERATION HAS GOT, read from its own table namespace with no engine (ADR-0053). */
+async function positionOf(indexer: RunningIndexer, digest: string): Promise<number | undefined> {
+	const target = (await listingOf(indexer)).generations.find((entry) => entry.digest === digest);
+	if (!target) throw new Error(`this deployment holds no generation ${digest}`);
+	return indexer.container.registry.readStateCursor({stream: target.stream, processor: target.processor});
+}
+
+async function until<T>(read: () => Promise<T>, done: (value: T) => boolean, what: string): Promise<T> {
+	const deadline = Date.now() + 10_000;
+	for (;;) {
+		const value = await read();
+		if (done(value)) return value;
+		if (Date.now() > deadline) throw new Error(`timed out waiting for ${what}; last saw ${JSON.stringify(value)}`);
+		await new Promise((resolve) => setTimeout(resolve, 5));
+	}
+}
+
+/** The single entity the bundles above declare, as a reader of the database has to name it. */
+const NFT = declareEntities([{name: 'nft', id: ['tokenID'], fields: {owner: 'text'}}]);
+
+/** WHAT ONE GENERATION'S OWN NAMESPACE ANSWERS, so which fold produced a row is readable. */
+async function ownerIn(db: RemoteSQL, digest: string, id: bigint): Promise<string | undefined> {
+	const store = new VersionedStateStore(db, NFT, {tableNamespace: digest});
+	const held = await store.getCurrent<{owner: string}>('nft', {tokenID: id.toString().padStart(78, '0')});
+	return held?.owner;
+}
+
+// ---------------------------------------------------------------------------------------------------
+
+describe('a restart with a changed processor, measured on the wire', () => {
+	it('RE-FOLDS the stored stream and asks the node for no range the stream already covers', async () => {
+		const db = oneDatabase();
+		const path = await aProcessorBundleOnDisk(processorBundleSource({credit: 'to'}));
+
+		// RUN ONE: the deployment that buys the history. It fetches from the source's
+		// own start block, which is what makes the second run's reads a comparison
+		// rather than an absolute.
+		const first = await aRunOver(db, path);
+		const incumbent = (await listingOf(first.indexer)).generations.find((entry) => entry.canonical)
+			?.digest as string;
+		expect(incumbent).toBeDefined();
+		await until(() => positionOf(first.indexer, incumbent), (at) => at === TIP, `the incumbent to reach ${TIP}`);
+		expect(first.chain.logRanges.some((range) => range.from === START_BLOCK)).toBe(true);
+		await stop();
+
+		// THE REDEPLOY: one edited handler at the same path, so the bytes moved and the
+		// identity with them, with no author action (ADR-0086). Same source, same stream
+		// config -- so the same STREAM, which the database already holds in full.
+		await writeFile(path, processorBundleSource({credit: 'from'}), 'utf-8');
+		const restarted = await aRunOver(db, path);
+		const successor = (await listingOf(restarted.indexer)).generations
+			.map((entry) => entry.digest)
+			.find((one) => one !== incumbent) as string;
+		expect(successor, `the restart registered no successor beside ${incumbent}`).toBeDefined();
+
+		// it really does catch up, so the assertion below is about a fold that FINISHED
+		// rather than one that never started
+		await until(() => positionOf(restarted.indexer, successor), (at) => at === TIP, `the successor to reach ${TIP}`);
+
+		// THE MEASUREMENT: not one `eth_getLogs` for a range the stored stream already
+		// covers. Before this, the ranges this run asked for began at `START_BLOCK` --
+		// the whole history, bought a second time from a node that may not serve it.
+		const historical = restarted.chain.logRanges.filter((range) => range.from <= TIP);
+		expect(historical, JSON.stringify(restarted.chain.logRanges)).toEqual([]);
+		// AND NOTHING ELSE EITHER, which is the finding this measurement produced: the
+		// only method this whole run asked the node for is `eth_chainId`. The restarted
+		// deployment holds a FOLLOWER, a follower has no receiver, and `reconcileWriters`
+		// hands the wire only to the fold `writerOf` names -- which is the incumbent,
+		// registered and not held. So it re-folds and then stops indexing for ever.
+		expect([...new Set(restarted.chain.calls.map((call) => call.method))]).toEqual(['eth_chainId']);
+
+		// ...and the fold it did is the NEW one's, over the SAME logs: the incumbent
+		// credited the receiver of the last transfer and the successor credits the
+		// sender, both out of one stored history
+		expect(await ownerIn(db, incumbent, 1n)).toBe(BOB.toLowerCase());
+		expect(await ownerIn(db, successor, 1n)).toBe(ALICE.toLowerCase());
+	});
+});

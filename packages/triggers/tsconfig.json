{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		// written under it in its own repo, and kept: stricter than tsconfig.base.json, never looser
		"noUncheckedIndexedAccess": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}

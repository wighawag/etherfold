{
	"name": "@etherfold/triggers",
	"version": "0.0.0",
	"description": "The core of etherfold's reference trigger service: follow an indexer's canonical feed, match triggers held as data, and deliver idempotent actions (a Web Push, a reward call) through a durable outbox. Platform-neutral: it takes a remote-sql database and a fetch. It runs as its own process, never inside the indexer-server (ADR-0005).",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/etherfold.git",
		"directory": "packages/triggers"
	},
	"dependencies": {
		"delegated-identity": "^0.1.1",
		"hono": "^4.13.3",
		"remote-sql": "^0.0.7",
		"viem": "^2.52.0"
	},
	"devDependencies": {
		"@etherfold/core": "workspace:*",
		"@etherfold/processor-entities": "workspace:*",
		"@etherfold/processor-sqlite": "workspace:*",
		"@etherfold/server": "workspace:*",
		"@libsql/client": "^0.17.3",
		"@push-notification/cli": "^0.1.0",
		"@types/node": "^25.9.1",
		"as-soon": "^0.1.5",
		"remote-sql-libsql": "^0.0.7",
		"typescript": "^6.0.3",
		"typia": "7.6.4",
		"vitest": "^4.1.8"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"prepack": "cp ../../LICENSE LICENSE",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"dev": "as-soon -w src pnpm build",
		"test": "vitest run",
		"test:watch": "vitest"
	}
}

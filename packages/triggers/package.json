{
	"name": "etherfold-triggers",
	"version": "0.0.0",
	"description": "The core of a trigger service for etherfold: follow an indexer's canonical feed, match triggers as data, and deliver idempotent actions through a durable outbox.",
	"type": "module",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/etherfold-triggers.git",
		"directory": "packages/triggers"
	},
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "rm -rf dist && tsc",
		"typecheck": "tsc -p tsconfig.typecheck.json"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"typescript": "^6.0.3"
	}
}

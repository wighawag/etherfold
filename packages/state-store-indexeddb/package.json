{
	"name": "@etherfold/state-store-indexeddb",
	"version": "0.1.1",
	"description": "The browser state store: versioned rows in IndexedDB, so a tab keeps history, reverts a reorg and pays a write cost proportional to what changed rather than to total state.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"typedoc": {
		"entryPoint": "src/index.ts"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/etherfold.git",
		"directory": "packages/state-store-indexeddb"
	},
	"dependencies": {
		"@etherfold/state-store": "workspace:*"
	},
	"devDependencies": {
		"@etherfold/core": "workspace:*",
		"@etherfold/processor-entities": "workspace:*",
		"@etherfold/state-store-conformance": "workspace:*",
		"@playwright/test": "^1.62.1",
		"@types/node": "^25.9.1",
		"as-soon": "^0.1.5",
		"esbuild": "^0.28.0",
		"fake-indexeddb": "^6.2.2",
		"playwright-browser-harness": "^0.3.0",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"prepack": "cp ../../LICENSE LICENSE",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"dev": "as-soon -w src pnpm build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:browser": "playwright test"
	}
}

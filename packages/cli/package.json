{
	"name": "etherfold",
	"version": "1.0.0",
	"description": "The etherfold command line: `run` follows a chain, folds a processor into a libSQL database and answers HTTP in one process; `build` is the same one shot, exiting at the tip; `fetch` is the chain-facing half, pushing raw logs to a server elsewhere; `index` receives those pushes and owns the database; `serve` answers queries over a database written elsewhere.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/etherfold.git",
		"directory": "packages/cli"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"etherfold": "dist/cli.js"
	},
	"dependencies": {
		"@etherfold/core": "workspace:*",
		"@etherfold/fetcher-host": "workspace:*",
		"@etherfold/platform-nodejs": "workspace:*",
		"@etherfold/platform-nodejs-fetcher": "workspace:*",
		"@etherfold/processor-entities": "workspace:*",
		"@etherfold/server": "workspace:*",
		"@etherfold/state-store-sqlite": "workspace:*",
		"@etherfold/utils": "workspace:*",
		"commander": "^15.0.0",
		"eip-1193": "^0.6.5",
		"eip-1193-jsonrpc-provider": "^0.4.3",
		"ldenv": "^0.5.0",
		"named-logs": "^0.4.1",
		"named-logs-console": "^0.5.1",
		"remote-sql": "^0.0.7"
	},
	"devDependencies": {
		"@etherfold/state-store": "workspace:*",
		"@libsql/client": "^0.17.3",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^25.9.1",
		"as-soon": "^0.1.5",
		"fs-extra": "^11.3.5",
		"remote-sql-libsql": "^0.0.7",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"prepack": "cp ../../LICENSE LICENSE",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"dev": "as-soon -w src pnpm build",
		"test": "vitest run",
		"test:watch": "vitest",
		"cli": "node ./dist/cli.js",
		"test:manual": "ldenv -m localhost node ./dist/cli.js -p ../../../../../wighawag/jolly-roger/indexer/dist/index.js -n @@RPC_URL_:DEPLOYMENT_CONTEXT,RPC_URL -f output.json -d ../../../../wighawag/jolly-roger/contracts/deployments/@@DEPLOYMENT_CONTEXT @@"
	}
}

{
	"name": "@etherfold/browser",
	"version": "1.0.0",
	"description": "Index a chain in the browser tab: the etherfold engine wrapped in observable stores (state, syncing, status), with IndexedDB persistence, auto-indexing and in-place reconfigure.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/etherfold.git",
		"directory": "packages/browser"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"typedoc": {
		"entryPoint": "src/index.ts"
	},
	"devDependencies": {
		"@etherfold/processor-entities": "workspace:*",
		"@etherfold/state-store-patch": "workspace:*",
		"@playwright/test": "^1.62.1",
		"as-soon": "^0.1.5",
		"esbuild": "^0.28.0",
		"fake-indexeddb": "^6.2.5",
		"playwright-browser-harness": "^0.3.0",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@etherfold/core": "workspace:*",
		"@etherfold/state-store": "workspace:*",
		"@etherfold/state-store-indexeddb": "workspace:*",
		"eip-1193": "^0.6.5",
		"idb-keyval": "^6.2.4",
		"named-logs": "^0.4.1",
		"sveltore": "^0.0.2",
		"use-stores": "^0.2.1"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"prepack": "cp ../../LICENSE LICENSE",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"dev": "as-soon -w src pnpm build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:browser": "playwright test"
	}
}

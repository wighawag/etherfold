{
	"name": "@etherfold/state-store-conformance",
	"version": "0.1.1",
	"description": "The conformance suite a state-store backend must pass to earn its place behind the seam: external-behaviour cases for versioned reads, as-of reads tested against the backend's own capability claims, reorg revert with a counter that must decrease, read-your-writes and block atomicity.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"typedoc": {
		"entryPoint": "src/index.ts"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/etherfold.git",
		"directory": "packages/state-store-conformance"
	},
	"dependencies": {
		"@etherfold/state-store": "workspace:*"
	},
	"peerDependencies": {
		"vitest": ">=3"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"as-soon": "^0.1.5",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"prepack": "cp ../../LICENSE LICENSE",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"dev": "as-soon -w src pnpm build",
		"test": "vitest run",
		"test:watch": "vitest"
	}
}

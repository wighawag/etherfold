{
	"name": "@etherfold/state-store",
	"version": "1.0.0",
	"description": "The backend-agnostic state-store contract: entity declarations, the mutation context a handler writes through, the interface a versioned store implements, and the capabilities it declares.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"typedoc": {
		"entryPoint": "src/index.ts"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/etherfold.git",
		"directory": "packages/state-store"
	},
	"dependencies": {},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"as-soon": "^0.1.5",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"prepack": "cp ../../LICENSE LICENSE",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"dev": "as-soon -w src pnpm build",
		"test": "vitest run",
		"test:watch": "vitest"
	}
}

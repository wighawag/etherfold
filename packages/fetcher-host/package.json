{
	"name": "@etherfold/fetcher-host",
	"version": "0.2.0",
	"description": "The host-side half of the log-fetcher: configuration, what a cycle's outcome means, how long to wait before the next one, and the two shapes a host schedules in (a loop, one bounded run). Names no runtime.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"typedoc": {
		"entryPoint": "src/index.ts"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/etherfold.git",
		"directory": "packages/fetcher-host"
	},
	"dependencies": {
		"@etherfold/core": "workspace:*",
		"eip-1193": "^0.6.5",
		"eip-1193-jsonrpc-provider": "^0.4.3",
		"named-logs": "^0.4.1"
	},
	"devDependencies": {
		"@etherfold/processor-sqlite": "workspace:*",
		"@etherfold/server": "workspace:*",
		"@libsql/client": "^0.17.3",
		"@types/node": "^25.9.1",
		"as-soon": "^0.1.5",
		"remote-sql": "^0.0.7",
		"remote-sql-libsql": "^0.0.7",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"prepack": "cp ../../LICENSE LICENSE",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"dev": "as-soon -w src pnpm build",
		"test": "vitest run",
		"test:watch": "vitest"
	}
}

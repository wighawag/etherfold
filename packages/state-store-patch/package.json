{
	"name": "@etherfold/state-store-patch",
	"version": "0.1.1",
	"description": "The light state store: current state as a plain object, history as immer reverse patches, reorg revert by replaying them backwards. Memory-only, and it advertises revert-only.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"typedoc": {
		"entryPoint": "src/index.ts"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/etherfold.git",
		"directory": "packages/state-store-patch"
	},
	"dependencies": {
		"@etherfold/state-store": "workspace:*",
		"immer": "^11.1.8"
	},
	"devDependencies": {
		"@etherfold/state-store-conformance": "workspace:*",
		"@types/node": "^25.9.1",
		"as-soon": "^0.1.5",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"prepack": "cp ../../LICENSE LICENSE",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"dev": "as-soon -w src pnpm build",
		"test": "vitest run",
		"test:watch": "vitest"
	}
}

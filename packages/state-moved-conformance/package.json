{
	"name": "@etherfold/state-moved-conformance",
	"version": "0.2.0",
	"description": "The conformance suite a state-moved TRANSPORT must pass to be an adapter rather than a second semantics: one parameterised case list, run over a worker's port, the cross-tab channel and a server's stream, asserting the app-visible outcome of an append, a retraction, a promotion and a dropped notification is identical on all of them.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"typedoc": {
		"entryPoint": "src/index.ts"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/etherfold.git",
		"directory": "packages/state-moved-conformance"
	},
	"dependencies": {
		"@etherfold/core": "workspace:*"
	},
	"peerDependencies": {
		"vitest": ">=3"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"as-soon": "^0.1.5",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"prepack": "cp ../../LICENSE LICENSE",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"dev": "as-soon -w src pnpm build",
		"test": "vitest run --passWithNoTests"
	}
}

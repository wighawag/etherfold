{
  "name": "etherfold-monorepo",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "dorfl": "^0.13.4",
    "ipfs-gateway-emulator": "4.2.1-ipfs.2",
    "ldenv": "^0.5.0",
    "prettier": "^3.8.3",
    "pwag": "^0.4.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "4.11.0",
    "typedoc-vitepress-theme": "1.1.2",
    "typescript": "^6.0.3",
    "vitepress": "1.6.4",
    "zellij-launcher": "^0.0.1"
  },
  "scripts": {
    "prepare": "pnpm build",
    "preinstall": "npx only-allow pnpm",
    "cleandep": "rm -rf node_modules && pnpm -r exec rm -rf node_modules",
    "---------------------- PUBLISH --------------------": "",
    "prepublishOnly": "pnpm format:check && pnpm build",
    "release": "pnpm prepublishOnly && git push --all && pnpm changeset publish && git push --tags",
    "release:ci": "pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm changeset publish",
    "reserve-npm-names": "node scripts/reserve-npm-names.mjs",
    "---------------------- FORMAT ----------------------": "",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "------- CHECK (in the acceptance gate: an ADR number is a stable reference, so two ADRs may not claim one) -------": "",
    "check:adr": "node scripts/check-adr-numbers.mjs",
    "---------------------- DEV ----------------------": "",
    "dev": "ldenv pnpm --filter './packages/*' --filter './platforms/*' dev",
    "---------------------- TEST ----------------------": "",
    "------- TEST (examples/ IS in this filter, deliberately: an example is EVIDENCE -- `event-processor-nfts` runs its own processor under the CLI -- and evidence nothing runs is a claim. Packages with no `test` script are skipped) -------": "",
    "test": "ldenv pnpm --filter './packages/*' --filter './platforms/*' --filter './examples/*' test",
    "------- TYPECHECK (every .ts in a package, dist/ aside; RUN AFTER build: cross-package types resolve through dist/) -------": "",
    "------- examples/ IS in this filter, deliberately: it was the one tree no gate reached, and ~300 lines of shipped app code lived there typechecked by nothing -------": "",
    "typecheck": "ldenv pnpm --filter './packages/*' --filter './platforms/*' --filter './examples/*' typecheck",
    "---------------------- BUILD ----------------------": "",
    "build": "ldenv pnpm --filter './packages/*' --filter './platforms/*' build",
    "build:examples": "ldenv pnpm --filter './examples/*' build",
    "---------------------- DOCUMENTATION ----------------------": "",
    "publish-typedoc": "typedoc --options typedoc.json ",
    "serve-docs": "ipfs-emulator --only -d docs -p 8080",
    "docs:dev": "pwag docs/public/icon.svg docs/web-config.json -o docs/public && npm run publish-typedoc && vitepress dev docs",
    "docs:build": "pwag docs/public/icon.svg docs/web-config.json -o docs/public && npm run publish-typedoc && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "---------------------- RUN FULL LOCAL SETUP ----------------------": "",
    "stop": "zellij kill-session $npm_package_name",
    "start:pnpm": "pnpm -r dev",
    "start": "zellij-launcher a $npm_package_name || zellij -n zellij.kdl -s $npm_package_name"
  },
  "pnpm": {
    "overrides": {
      "abitype": "1.2.4"
    }
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316"
}

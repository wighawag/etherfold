/docs/.vitepress/*
!/docs/.vitepress/theme
!/docs/.vitepress/config.mts
/docs/api
/docs/public/examples
/docs/public/pwa

# this need to be copied in
/docs/examples
/docs/media

prompts

# Playwright (browser tests in packages/state-store-indexeddb)
test-results/
playwright-report/

# Wrangler's local scratch: `platforms/cf-worker`'s tests run under
# vitest-pool-workers, which writes a `.wrangler/tmp` beside the worker on every
# run. Runtime artifact, recreated at will, never source.
.wrangler/

# Agent tooling scratch (subagent run artifacts)
.pi-subagents/

# Copied in at pack/publish time by each package's `prepack`, because npm reads
# a LICENSE only from the package DIRECTORY, never from the repo root.
# Generated, so not source: committed, they would be 19 copies free to drift
# from the single file they mirror.
#
# A README is NOT in this list: every package now has its OWN, describing that
# package, so there is nothing being mirrored. `packages/cli/README.md` used to
# be a copy of the root one and is now the CLI's own committed file.
/packages/*/LICENSE
/platforms/*/LICENSE

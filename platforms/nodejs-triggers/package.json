{
	"name": "@etherfold/platform-nodejs-triggers",
	"version": "0.0.0",
	"description": "etherfold's reference trigger service on Node.js and libSQL: the `etherfold-triggers` command, which runs a consumer of an indexer's canonical feed, its deliveries and its registration API from one config file, as its own process beside `etherfold run`.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"etherfold-triggers": "dist/cli.js"
	},
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/etherfold.git",
		"directory": "platforms/nodejs-triggers"
	},
	"dependencies": {
		"@etherfold/triggers": "workspace:*",
		"@hono/node-server": "^2.1.1",
		"@libsql/client": "^0.17.3",
		"remote-sql": "^0.0.7",
		"remote-sql-libsql": "^0.0.7"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"as-soon": "^0.1.5",
		"typescript": "^6.0.3",
		"viem": "^2.52.0",
		"vitest": "^4.1.8"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"prepack": "cp ../../LICENSE LICENSE",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"dev": "as-soon -w src pnpm build",
		"test": "vitest run",
		"test:watch": "vitest"
	}
}

{
	"name": "@etherfold/platform-nodejs-fetcher",
	"version": "1.0.0",
	"description": "Node host adapter for the etherfold log-fetcher: the loop that drives fetch cycles on an interval with backoff, the signals that stop it and the exit code it resolves. Configuration and scheduling only, as a library with no binary -- `etherfold fetch` is the command that runs one.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"typedoc": {
		"entryPoint": "src/index.ts"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/etherfold.git",
		"directory": "platforms/nodejs-fetcher"
	},
	"dependencies": {
		"@etherfold/core": "workspace:*",
		"@etherfold/fetcher-host": "workspace:*",
		"named-logs": "^0.4.1"
	},
	"devDependencies": {
		"@etherfold/processor-sqlite": "workspace:*",
		"@etherfold/server": "workspace:*",
		"@hono/node-server": "^2.1.1",
		"@libsql/client": "^0.17.3",
		"@types/node": "^25.9.1",
		"as-soon": "^0.1.5",
		"remote-sql": "^0.0.7",
		"remote-sql-libsql": "^0.0.7",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"prepack": "cp ../../LICENSE LICENSE",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"dev": "as-soon -w src pnpm build",
		"test": "vitest run",
		"test:watch": "vitest"
	}
}
